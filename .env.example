# ---------------------------------------------------------------------------
# GEMINI AI CONFIGURATION (Required)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# INSTAGRAM DIRECT UPLOAD - METHOD A: Direct Account Login (Easiest)
# Use your Instagram username and password. No Meta developer account needed!
# ---------------------------------------------------------------------------
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# Optional: If you use 2FA or prefer session token:
INSTAGRAM_SESSION_ID=

# ---------------------------------------------------------------------------
# INSTAGRAM DIRECT UPLOAD - METHOD B: Official Meta Graph API
# For Instagram Business / Creator accounts linked to a Facebook Page.
# ---------------------------------------------------------------------------
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# Preferred method: 'auto', 'direct', or 'graph_api'
INSTAGRAM_UPLOAD_METHOD=auto

# ---------------------------------------------------------------------------
# AUTONOMOUS AGENT & SCHEDULING SETTINGS
# ---------------------------------------------------------------------------
AUTO_POST_INTERVAL_HOURS=12
CONTENT_NICHE=Vedic astrology
CONTENT_LANGUAGE=Hindi mixed with English
CONTENT_THEME=cosmic
DEFAULT_VOICE=hi-IN-MadhurNeural

# Voice Settings: "edge_neural" (100% Free Native Indian Voice) or "elevenlabs"
VOICE_ENGINE=edge_neural
VOICE_MODE=smart
VOICE_GENDER=male

# Brand watermark for video overlays
BRAND_WATERMARK=@neodivinestore.in

# ---------------------------------------------------------------------------
# APPLICATION SETTINGS
# ---------------------------------------------------------------------------
APP_ENV=development
TIMEZONE=Asia/Kolkata
