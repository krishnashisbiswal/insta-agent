# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Secrets & Environment
.env
.env.*
!.env.example

# Generated media and runtime artifacts
output/*
!output/.gitkeep
assets/generated_broll/*
!assets/generated_broll/.gitkeep
scratch/*
*TEMP_MPY_*
*.mp4.jpg

# Runtime-generated previews and videos in insta content
insta content/*.gif
insta content/*.mp4
insta content/*.mp3
insta content/*.jpg
!insta content/.gitkeep
!insta content/README.md
!insta content/caption_and_hashtags.txt
!insta content/content_overview.json

# Storage runtime states & databases (only permanent registries are tracked in git)
storage/*
!storage/.gitkeep
!storage/used_visuals_registry.json
!storage/permanent_visual_registry.json

# Logs
logs/
*.log

# IDE
.vscode/
.idea/
